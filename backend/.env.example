PORT=5200
# Bind to loopback only; Nginx is the public entry point
HOST=127.0.0.1
# Comma-separated allowed origins, e.g. https://consultation.herbsmagic.in
CORS_ORIGIN=https://consultation.herbsmagic.in
# Optional absolute path for SQLite file (keep outside the git checkout)
DB_PATH=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CONSULTATION_FEE=499
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DOCTOR_EMAIL=
NODE_ENV=production
# Required to read GET /api/b2b-appointments (send as "Authorization: Bearer <token>")
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
